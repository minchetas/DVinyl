<%
    // Fork-only. Mode mirrors plugins/music/spotify.ts's getSpotifyMode() — duplicated
    // inline here (view-side, no server round trip) rather than imported, matching how
    // bootleg-toggle.ejs reads its own plugin setting directly.
    const musicSettings = (settings && settings.pluginSettings && settings.pluginSettings.music) || {};
    const spotifyClientId = musicSettings.spotifyClientId || process.env.SPOTIFY_CLIENT_ID || '';
    const spotifyClientSecret = musicSettings.spotifyClientSecret || process.env.SPOTIFY_CLIENT_SECRET || '';
    const spotifyMode = !musicSettings.spotifyEnabled ? 'off' : (spotifyClientId && spotifyClientSecret ? 'embed' : 'link');
%>
<% if (spotifyMode !== 'off') { %>
    <div id="spotifyTrigger" class="card-theme rounded-xl border border-black/10 dark:border-white/10 shadow-sm overflow-hidden transition-colors">
        <% if (spotifyMode === 'link') { %>
            <a href="https://open.spotify.com/search/<%= encodeURIComponent(item.artist + ' ' + item.title) %>"
               target="_blank" rel="noopener"
               class="flex items-center gap-3 px-6 py-4 hover:bg-black/5 dark:hover:bg-white/5 transition-colors group">
                <svg class="w-5 h-5 text-[#1DB954] shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
                <span class="text-sm font-medium"><%= t('spotify.open_in') %></span>
                <i class="fa-solid fa-arrow-up-right-from-square text-xs opacity-40 ml-auto group-hover:opacity-70 transition-opacity"></i>
            </a>
        <% } else { %>
            <button id="spotifyBtn" onclick="loadSpotifyPlayer()"
               class="w-full flex items-center gap-3 px-6 py-4 hover:bg-black/5 dark:hover:bg-white/5 transition-colors group text-left">
                <svg id="spotifyBtnIcon" class="w-5 h-5 text-[#1DB954] shrink-0" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/></svg>
                <span id="spotifyBtnLabel" class="text-sm font-medium"><%= t('spotify.open_in') %></span>
                <i id="spotifyBtnArrow" class="fa-solid fa-play text-xs opacity-40 ml-auto group-hover:opacity-70 transition-opacity"></i>
            </button>
            <script>
            function loadSpotifyPlayer() {
                var btn   = document.getElementById('spotifyBtn');
                var label = document.getElementById('spotifyBtnLabel');
                var arrow = document.getElementById('spotifyBtnArrow');
                btn.disabled = true;
                arrow.className = 'fa-solid fa-circle-notch fa-spin text-xs opacity-40 ml-auto';
                label.textContent = <%- JSON.stringify(t('spotify.loading')) %>;
                var artist = <%- JSON.stringify(item.artist) %>;
                var title  = <%- JSON.stringify(item.title) %>;
                var base   = '<%- baseUrl %>';
                fetch(base + '/api/spotify/search?artist=' + encodeURIComponent(artist) + '&title=' + encodeURIComponent(title))
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data.mode === 'embed') {
                            document.getElementById('spotifyTrigger').innerHTML = '<iframe style="border-radius:12px;display:block" src="' + data.embedUrl + '" width="100%" height="352" frameborder="0" allowfullscreen allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture; storage-access" loading="lazy"></iframe>';
                        } else {
                            window.open(data.searchUrl, '_blank');
                            btn.disabled = false;
                            arrow.className = 'fa-solid fa-play text-xs opacity-40 ml-auto group-hover:opacity-70 transition-opacity';
                            label.textContent = <%- JSON.stringify(t('spotify.open_in')) %>;
                        }
                    })
                    .catch(function() {
                        btn.disabled = false;
                        arrow.className = 'fa-solid fa-play text-xs opacity-40 ml-auto group-hover:opacity-70 transition-opacity';
                        label.textContent = <%- JSON.stringify(t('spotify.open_in')) %>;
                    });
            }
            </script>
        <% } %>
    </div>
<% } %>
